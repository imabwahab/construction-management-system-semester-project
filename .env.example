# Copy to your environment / host config. Do NOT commit a real .env.
# All values are optional in development (sane defaults are used).

# Security
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database (omit entirely to use SQLite in development).
# Set DB_ENGINE=mysql for production (requires `pip install mysqlclient`).
DB_ENGINE=mysql
DB_NAME=construction
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=3306
